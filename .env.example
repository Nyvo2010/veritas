# Veritas environment template.
#
# Copy to `.env` for local / non-interactive use, or store the same values via
# `veritas` > Settings. Environment variables take precedence over the settings
# file. Veritas bundles no provider: any OpenAI-compatible endpoint works, so
# LLM_BASE_URL and LLM_MODEL must be set here (or in Settings).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional: retried once when the primary model keeps failing. Empty disables it.
LLM_FALLBACK_MODEL=
TAVILY_API_KEY=
# Override the reports directory (default: ~/Veritas/reports).
VERITAS_REPORTS_DIR=
