# Copy to .env (local runs) or store via `veritas` > Settings.
# Environment variables take precedence over the settings file.
# Any OpenAI-compatible endpoint works; NVIDIA NIM is the default.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=
# Optional: retried when the primary model keeps failing. Empty disables it.
LLM_FALLBACK_MODEL=
TAVILY_API_KEY=
# Legacy names still honored as fallback:
# NVIDIA_API_KEY=
# NVIDIA_API_BASE_URL=
# Override the reports directory.
VERITAS_REPORTS_DIR=
